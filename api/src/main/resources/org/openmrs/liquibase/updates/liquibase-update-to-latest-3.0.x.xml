	<!-- Assertion model, phase 1: typed principals. See CHANGELOG-assertion-model.md -->

	<changeSet id="assertion-model-p1-users-user-type-2026-10-22" author="pbiondich">
		<preConditions onFail="MARK_RAN">
			<not>
				<columnExists tableName="users" columnName="user_type"/>
			</not>
		</preConditions>
		<comment>Add users.user_type (HUMAN | DEVICE | SOFTWARE); existing users become HUMAN</comment>
		<addColumn tableName="users">
			<column name="user_type" type="VARCHAR(50)" defaultValue="HUMAN">
				<constraints nullable="false"/>
			</column>
		</addColumn>
		<rollback>
			<dropColumn tableName="users" columnName="user_type"/>
		</rollback>
	</changeSet>

	<changeSet id="assertion-model-p1-users-person-id-nullable-2026-10-22" author="pbiondich">
		<comment>
			Make users.person_id nullable so DEVICE and SOFTWARE users need no person row.
			Rolling back fails while any user has a null person_id; give those users a person or delete them first.
		</comment>
		<dropNotNullConstraint tableName="users" columnName="person_id" columnDataType="INT"/>
		<rollback>
			<addNotNullConstraint tableName="users" columnName="person_id" columnDataType="INT"/>
		</rollback>
	</changeSet>

	<changeSet id="assertion-model-p1-daemon-user-software-2026-10-22" author="pbiondich">
		<comment>The Daemon user is software, not a person. Updates nothing if there is no Daemon user.</comment>
		<update tableName="users">
			<column name="user_type" value="SOFTWARE"/>
			<where>uuid = 'A4F30A1B-5EB9-11DF-A648-37A07F9C90FB'</where>
		</update>
		<rollback>
			<update tableName="users">
				<column name="user_type" value="HUMAN"/>
				<where>uuid = 'A4F30A1B-5EB9-11DF-A648-37A07F9C90FB'</where>
			</update>
		</rollback>
	</changeSet>

	<changeSet id="assertion-model-p1-software-agent-2026-10-22" author="pbiondich">
		<preConditions onFail="MARK_RAN">
			<not>
				<tableExists tableName="software_agent"/>
			</not>
		</preConditions>
		<comment>
			One row per version of a piece of software that acts as a user. The version is part of the identity, so
			each version is its own user, and all versions of the software share its name
		</comment>
		<createTable tableName="software_agent">
			<column name="user_id" type="INT">
				<constraints nullable="false" primaryKey="true"/>
			</column>
			<column name="name" type="VARCHAR(255)">
				<constraints nullable="false"/>
			</column>
			<column name="version" type="VARCHAR(50)">
				<constraints nullable="false"/>
			</column>
			<column name="model_identifier" type="VARCHAR(255)"/>
			<column name="config_hash" type="VARCHAR(64)"/>
		</createTable>
		<addUniqueConstraint tableName="software_agent" columnNames="name, version"
			constraintName="software_agent_name_version"/>
		<addForeignKeyConstraint baseTableName="software_agent" baseColumnNames="user_id"
			constraintName="software_agent_user" referencedTableName="users" referencedColumnNames="user_id"/>
		<rollback>
			<dropTable tableName="software_agent"/>
		</rollback>
	</changeSet>

	<changeSet id="assertion-model-p1-device-agent-2026-10-22" author="pbiondich">
		<preConditions onFail="MARK_RAN">
			<not>
				<tableExists tableName="device_agent"/>
			</not>
		</preConditions>
		<comment>
			One row per device that acts as a user, such as an analyser or a monitor. The identifier names the device
			and never changes; the location is where the device is now
		</comment>
		<createTable tableName="device_agent">
			<column name="user_id" type="INT">
				<constraints nullable="false" primaryKey="true"/>
			</column>
			<column name="identifier" type="VARCHAR(255)">
				<constraints nullable="false" unique="true" uniqueConstraintName="device_agent_identifier"/>
			</column>
			<column name="location_id" type="INT"/>
		</createTable>
		<addForeignKeyConstraint baseTableName="device_agent" baseColumnNames="user_id"
			constraintName="device_agent_user" referencedTableName="users" referencedColumnNames="user_id"/>
		<addForeignKeyConstraint baseTableName="device_agent" baseColumnNames="location_id"
			constraintName="device_agent_location" referencedTableName="location" referencedColumnNames="location_id"/>
		<rollback>
			<dropTable tableName="device_agent"/>
		</rollback>
	</changeSet>

	<changeSet id="assertion-model-p1-provider-user-2026-10-22" author="pbiondich">
		<preConditions onFail="MARK_RAN">
			<not>
				<columnExists tableName="provider" columnName="user_id"/>
			</not>
		</preConditions>
		<comment>
			A digital provider is backed by a software or device user instead of a person. A user backs at most one
			provider
		</comment>
		<addColumn tableName="provider">
			<column name="user_id" type="INT"/>
		</addColumn>
		<addUniqueConstraint tableName="provider" columnNames="user_id" constraintName="provider_user"/>
		<addForeignKeyConstraint baseTableName="provider" baseColumnNames="user_id" constraintName="provider_user_fk"
			referencedTableName="users" referencedColumnNames="user_id"/>
		<rollback>
			<dropForeignKeyConstraint baseTableName="provider" constraintName="provider_user_fk"/>
			<dropUniqueConstraint tableName="provider" constraintName="provider_user"/>
			<dropColumn tableName="provider" columnName="user_id"/>
		</rollback>
	</changeSet>

	<changeSet id="assertion-model-p1-provider-type-2026-10-22" author="pbiondich">
		<preConditions onFail="MARK_RAN">
			<not>
				<columnExists tableName="provider" columnName="provider_type"/>
			</not>
		</preConditions>
		<comment>Add provider.provider_type (BIOLOGIC | DIGITAL); existing providers are people, so BIOLOGIC</comment>
		<addColumn tableName="provider">
			<column name="provider_type" type="VARCHAR(50)" defaultValue="BIOLOGIC">
				<constraints nullable="false"/>
			</column>
		</addColumn>
		<rollback>
			<dropColumn tableName="provider" columnName="provider_type"/>
		</rollback>
	</changeSet>

	<changeSet id="assertion-model-p1-obs-asserter-2026-10-22" author="pbiondich">
		<preConditions onFail="MARK_RAN">
			<not>
				<columnExists tableName="obs" columnName="asserter_id"/>
			</not>
		</preConditions>
		<comment>
			The provider who made the claim an obs records. Null means unknown. Rolling back drops every asserter recorded
			since; only the backfilled ones can be recovered
		</comment>
		<addColumn tableName="obs">
			<column name="asserter_id" type="INT"/>
		</addColumn>
		<createIndex tableName="obs" indexName="obs_asserter">
			<column name="asserter_id"/>
		</createIndex>
		<addForeignKeyConstraint baseTableName="obs" baseColumnNames="asserter_id" constraintName="obs_asserter_fk"
			referencedTableName="provider" referencedColumnNames="provider_id"/>
		<rollback>
			<dropForeignKeyConstraint baseTableName="obs" constraintName="obs_asserter_fk"/>
			<dropIndex tableName="obs" indexName="obs_asserter"/>
			<dropColumn tableName="obs" columnName="asserter_id"/>
		</rollback>
	</changeSet>

	<changeSet id="assertion-model-p1-obs-asserter-backfill-2026-10-22" author="pbiondich">
		<comment>
			Backfill the asserter only where the obs's encounter has exactly one provider; every other existing obs keeps
			an unknown asserter rather than a guess. Only fills obs whose asserter is still unknown
		</comment>
		<sql>
			UPDATE obs SET asserter_id = (
				SELECT CASE WHEN COUNT(DISTINCT ep.provider_id) = 1 THEN MIN(ep.provider_id) END
				FROM encounter_provider ep WHERE ep.encounter_id = obs.encounter_id AND ep.voided = FALSE)
			WHERE asserter_id IS NULL AND encounter_id IS NOT NULL
		</sql>
		<rollback>
			<!-- nothing to undo here: rolling back the previous changeset drops the column -->
		</rollback>
	</changeSet>

	<changeSet id="assertion-model-p1-daemon-no-person-2026-10-22" author="pbiondich">
		<comment>
			The Daemon user is software, so it has no person. It used to share person 1 with the admin user only because
			users.person_id was required
		</comment>
		<update tableName="users">
			<column name="person_id" valueComputed="NULL"/>
			<where>uuid = 'A4F30A1B-5EB9-11DF-A648-37A07F9C90FB'</where>
		</update>
		<rollback>
			<sql>
				UPDATE users SET person_id = 1 WHERE uuid = 'A4F30A1B-5EB9-11DF-A648-37A07F9C90FB' AND person_id IS NULL
				AND EXISTS (SELECT 1 FROM person WHERE person_id = 1)
			</sql>
		</rollback>
	</changeSet>

	<changeSet id="assertion-model-p2-obs-finalization-policy-2026-10-22" author="pbiondich">
		<preConditions onFail="MARK_RAN">
			<not>
				<tableExists tableName="obs_finalization_policy"/>
			</not>
		</preConditions>
		<comment>
			Policies that say whether the obs a kind of agent asserts are final when saved or wait, preliminary, for a
			person to attest them; a policy for a concept class takes precedence over the agent type's policy for every
			class. Devices auto-finalize and software needs attestation
		</comment>
		<createTable tableName="obs_finalization_policy">
			<column name="obs_finalization_policy_id" autoIncrement="true" type="INT">
				<constraints nullable="false" primaryKey="true"/>
			</column>
			<column name="name" type="VARCHAR(255)">
				<constraints nullable="false"/>
			</column>
			<column name="description" type="VARCHAR(1024)"/>
			<column name="agent_type" type="VARCHAR(50)">
				<constraints nullable="false"/>
			</column>
			<column name="concept_class_id" type="INT"/>
			<column name="action" type="VARCHAR(50)">
				<constraints nullable="false"/>
			</column>
			<column name="creator" type="INT">
				<constraints nullable="false"/>
			</column>
			<column name="date_created" type="DATETIME">
				<constraints nullable="false"/>
			</column>
			<column name="changed_by" type="INT"/>
			<column name="date_changed" type="DATETIME"/>
			<column name="retired" type="BOOLEAN" defaultValueBoolean="false">
				<constraints nullable="false"/>
			</column>
			<column name="retired_by" type="INT"/>
			<column name="date_retired" type="DATETIME"/>
			<column name="retire_reason" type="VARCHAR(255)"/>
			<column name="uuid" type="CHAR(38)">
				<constraints nullable="false" unique="true"/>
			</column>
		</createTable>
		<addForeignKeyConstraint baseTableName="obs_finalization_policy" baseColumnNames="concept_class_id"
			constraintName="obs_finalization_policy_concept_class" referencedTableName="concept_class"
			referencedColumnNames="concept_class_id"/>
		<addForeignKeyConstraint baseTableName="obs_finalization_policy" baseColumnNames="creator"
			constraintName="obs_finalization_policy_creator" referencedTableName="users" referencedColumnNames="user_id"/>
		<addForeignKeyConstraint baseTableName="obs_finalization_policy" baseColumnNames="changed_by"
			constraintName="obs_finalization_policy_changed_by" referencedTableName="users" referencedColumnNames="user_id"/>
		<addForeignKeyConstraint baseTableName="obs_finalization_policy" baseColumnNames="retired_by"
			constraintName="obs_finalization_policy_retired_by" referencedTableName="users" referencedColumnNames="user_id"/>
		<insert tableName="obs_finalization_policy">
			<column name="name" value="Devices finalize their own obs"/>
			<column name="agent_type" value="DEVICE"/>
			<column name="action" value="AUTO_FINAL"/>
			<column name="creator" valueNumeric="1"/>
			<column name="date_created" valueDate="2026-10-22T00:00:00"/>
			<column name="uuid" value="9b7f4a2e-3c1d-4e8a-9f6b-2d5c8e1a7b30"/>
		</insert>
		<insert tableName="obs_finalization_policy">
			<column name="name" value="Software obs need attestation"/>
			<column name="agent_type" value="SOFTWARE"/>
			<column name="action" value="REQUIRE_ATTESTATION"/>
			<column name="creator" valueNumeric="1"/>
			<column name="date_created" valueDate="2026-10-22T00:00:00"/>
			<column name="uuid" value="4e2c9d81-7a5b-4f3e-8c6d-1b9a0e2f5d47"/>
		</insert>
		<rollback>
			<dropTable tableName="obs_finalization_policy"/>
		</rollback>
	</changeSet>

</databaseChangeLog>
